{
  "servers": [
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/qiang.lilq/personal-system"],
      "enabled": false
    },
    {
      "name": "fetch",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "enabled": false
    },
    {
      "name": "wiki-search",
      "transport": "stdio",
      "command": "uv",
      "args": ["--directory", "../personal-tools/archive/wiki-search", "run", "wiki-search-mcp"],
      "env": {
        "WIKI_SEARCH_API_URL": "http://127.0.0.1:8080"
      },
      "enabled": false
    },
    {
      "name": "http-example",
      "transport": "http",
      "url": "http://localhost:3000/mcp",
      "enabled": false
    },
    {
      "name": "browser",
      "transport": "stdio",
      "command": "python3",
      "args": ["var/mcp/browser_tools.py"],
      "enabled": false,
      "timeout": 120.0,
      "env": {
        "BROWSER_HEADLESS": "true",
        "BROWSER_DEFAULT_TIMEOUT": "30000",
        "BROWSER_MAX_OUTPUT_CHARS": "20000"
      }
    }
  ]
}

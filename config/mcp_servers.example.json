{
  "servers": [
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/qiang.lilq/personal-system"],
      "enabled": false
    },
    {
      "name": "fetch",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "enabled": false
    },
    {
      "name": "http-example",
      "transport": "http",
      "url": "http://localhost:3000/mcp",
      "enabled": false
    },
    {
      "name": "browser",
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": ["tools/mcp/browser_tools.py"],
      "enabled": false,
      "timeout": 120.0,
      "env": {
        "BROWSER_HEADLESS": "true",
        "BROWSER_DEFAULT_TIMEOUT": "30000",
        "BROWSER_MAX_OUTPUT_CHARS": "20000"
      }
    }
  ]
}
